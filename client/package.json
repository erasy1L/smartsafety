{
  "name": "smartsafety-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy localStorage cookie preferredLanguage baseLocale --emit-ts-declarations",
    "dev": "vite",
    "build": "npm run paraglide && tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.25.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@inlang/plugin-m-function-matcher": "^2.2.14",
    "@inlang/plugin-message-format": "^4.4.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
